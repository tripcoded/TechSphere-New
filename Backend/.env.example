APP_NAME=TechSphere Event Management API
APP_ENV=development
APP_DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGIN_REGEX=

SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_HASH_ITERATIONS=120000

# Supabase PostgreSQL URL example:
# DATABASE_URL=postgresql+psycopg2://postgres:password@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./techsphere.db

# Email provider:
# - auto: use Resend when RESEND_API_KEY is set, otherwise SMTP
# - smtp: always use SMTP
# - resend: always use Resend
EMAIL_PROVIDER=auto

# SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Resend settings (recommended on Render free web services)
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
# onboarding@resend.dev is test-only and can send only to your own Resend account email.
# For real users, verify your domain in Resend and use something like no-reply@yourdomain.com.
RESEND_FROM_EMAIL=onboarding@resend.dev

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_EMAIL_MAX_REQUESTS=3
OTP_IP_MAX_REQUESTS=10
OTP_RATE_WINDOW_SECONDS=900

ADMIN_API_KEY=replace-with-strong-admin-api-key
